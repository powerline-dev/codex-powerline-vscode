{
  "name": "codex-powerline-vscode",
  "displayName": "Codex Powerline",
  "description": "Run the Codex Powerline terminal in a VS Code sidebar.",
  "version": "0.2.0",
  "publisher": "powerline-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": ["Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/powerline-dev/codex-powerline-vscode.git"
  },
  "extensionKind": ["workspace"],
  "capabilities": {
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexPowerline",
          "title": "Codex Powerline",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "codexPowerline": [
        {
          "id": "codexPowerline.terminal",
          "name": "Terminal",
          "type": "webview",
          "icon": "$(terminal)"
        }
      ]
    },
    "commands": [
      {
        "command": "codexPowerline.restartTerminal",
        "category": "Codex Powerline",
        "title": "Restart Terminal",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexPowerline.restartTerminal",
          "when": "view == codexPowerline.terminal",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --external:node-pty --outfile=dist/extension.js && esbuild src/webview.ts --bundle --platform=browser --outfile=dist/terminal.js",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0"
  }
}
